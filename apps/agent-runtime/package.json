{
  "name": "@insula/agent-runtime",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "private": true,
  "nx": {
    "targets": {
      "dev": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "wrangler dev",
          "cwd": "apps/agent-runtime"
        }
      },
      "deploy": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "typecheck"
        ],
        "options": {
          "command": "wrangler deploy",
          "cwd": "apps/agent-runtime"
        }
      },
      "cf-typegen": {
        "executor": "nx:run-commands",
        "options": {
          "command": "wrangler types env.d.ts --include-env=false",
          "cwd": "apps/agent-runtime"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run",
          "cwd": "apps/agent-runtime"
        }
      }
    },
    "tags": [
      "scope:agent",
      "type:app"
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.61",
    "@ai-sdk/google": "^4.0.78",
    "@ai-sdk/openai": "^4.0.73",
    "@insula/auth": "*",
    "@insula/contracts": "*",
    "@insula/crypto": "*",
    "agents": "^0.24.0",
    "ai": "^7.0.112",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260812.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.122.0"
  }
}
