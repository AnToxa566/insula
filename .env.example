# --- DB & Redis ------------------------------------------------------------
DATABASE_URL="postgresql://insula:insula@localhost:5432/insula?schema=public"
REDIS_URL="redis://localhost:6379"

# --- API -------------------------------------------------------------------
API_PORT=3333

# --- JWT -------------------------------------------------------------------
JWT_ACCESS_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# The key used by agent-runtime to sign short-lived service tokens,
# which are then validated by the api. In production - RS256 via Secret Manager.
AGENT_SERVICE_SECRET=""

# --- User key encryption ---------------------------------------------------
# Envelope encryption: KEK_PROVIDER selects the backend that wraps/unwraps
# each credential's per-row DEK. "local" (default) uses
# CREDENTIAL_ENCRYPTION_KEY directly with AES-256-GCM. "kms" is GCP Cloud
# KMS, wired but not yet callable — selecting it throws a clear
# "not configured" error until the GCP SDK dependency and credentials land.
KEK_PROVIDER="local"

# Required when KEK_PROVIDER=local. Must base64-decode to exactly 32 bytes
# (AES-256). Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=""

# --- Mail ------------------------------------------------------------------
# "console" (default) sends nothing — it logs only the template name and a
# masked recipient, never the body or the verification code. "brevo" sends
# through Brevo's REST API and requires BREVO_API_KEY and MAIL_FROM_EMAIL
# (a sender verified in Brevo). Keep BREVO_API_KEY out of git; Secret Manager
# in production. Leave the optional vars commented out rather than empty.
MAIL_TRANSPORT="console"
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=
# MAIL_FROM_NAME="Insula"

# --- Reverse proxy ---------------------------------------------------------
# Number of trusted proxies in front of the API, so per-IP rate limits see the
# real client address. 0 = none (local dev). Set to 1 on Cloud Run.
TRUST_PROXY_HOPS=0

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3333/api"
# The web app's own origin, so the API can allow it via CORS.
WEB_APP_URL="http://localhost:3000"
